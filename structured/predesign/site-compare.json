      "action": "取得三筆地籍圖、地號與界址查核；須有來源、查核人與日期，補上「三筆地界相鄰與各棟基地對應」",
      "responsible_role": "建築師／地政士／測量人員"
    },
    {
      "kind": "evidence",
      "target": "SITE-001 / SC-FRONTAGE-MIN",
      "action": "取得地籍圖或實測面寬，補上「每棟最小有效面寬」",
      "responsible_role": "屋主／建築師"
    },
    {
      "kind": "evidence",
      "target": "SITE-001 / SC-DEPTH-MIN",
      "action": "取得地籍圖或實測深度，補上「每棟最小有效深度」",
      "responsible_role": "屋主／建築師"
    },
    {
      "kind": "evidence",
      "target": "SITE-001 / SC-ROAD-WIDTH",
      "action": "取得都發局建築線指定或地籍圖說，補上「臨路寬度與退縮條件」",
      "responsible_role": "建築師"
    },
    {
      "kind": "evidence",
      "target": "SITE-001 / SC-CONSTRUCTION-ACCESS",
      "action": "取得現勘照片與路寬、轉彎半徑、限高紀錄，補上「施工車輛與吊裝進出」",
      "responsible_role": "屋主／營造廠"
    },
    {
      "kind": "evidence",
      "target": "SITE-001 / SC-THREE-PERMITS",
      "action": "取得建築師書面意見，補上「三棟能否各自申照與計量」",
      "responsible_role": "建築師／地政士"
    },
    {
      "kind": "evidence",
      "target": "SITE-001 / SC-CROSS-PARCEL-UTILITY",
      "action": "取得給水、電力、污雨排水、弱電各自的可接性、管路權利與責任分界書面查核；每個欄位皆須有來源、查核人與日期，補上「跨基地管線是否可行」",
      "responsible_role": "建築師／水電／公用事業單位"
    },
    {
      "kind": "evidence",
      "target": "SITE-001 / SC-CORE-FUNCTIONS",
      "action": "取得建築師逐棟核心機能配置評估與圖面證據；predesign envelope 只能當提問素材，不能當已確認證據，補上「A／B／C 核心功能能否同時容納」",
      "responsible_role": "屋主／建築師"
    },
    {
      "kind": "evidence",
      "target": "SITE-001 / SC-FLOOD",
      "action": "取得水利署防災資訊服務網查詢結果與雨後現勘，補上「淹水潛勢與基地標高排水」",
      "responsible_role": "屋主／建築師"
    },
    {
      "kind": "evidence",
      "target": "SITE-001 / SC-LIQUEFACTION",
      "action": "取得土壤液化潛勢查詢系統結果；必要時由技師判斷是否需鑽探，補上「土壤液化潛勢」",
      "responsible_role": "建築師／結構技師"
    },
    {
      "kind": "evidence",
      "target": "SITE-001 / SC-NEIGHBOUR-ENV",
      "action": "取得三個時段的現勘紀錄，補上「噪音、異味、鄰房開口與西曬」",
      "responsible_role": "屋主"
    },
    {
      "kind": "evidence",
      "target": "SITE-001 / SC-TOTAL-COST",
      "action": "取得私有預算表上限與建築師／營造廠粗估，補上「土地加基礎、管線與搬運後仍在預算內」",
      "responsible_role": "屋主／建築師"
    }
  ],

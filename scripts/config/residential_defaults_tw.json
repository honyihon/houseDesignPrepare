  "vehicle": {
    "_note": [
      "車庫尺寸的推導基準。使用者要求：車停在建築體內，車庫至少要放得下一台休旅車＋充電樁。",
      "這裡的數字是『淨尺寸』——車子實際停進去的空間，不含牆體。產生器會自己加牆厚。",
      "下限由此推導，不是另外寫死：淨深 = 車長 + 車頭服務區 + 車尾淨空；",
      "淨寬 = 車寬 × 車位數 + 駕駛側 + 乘客側 + 車位間距 ×(車位數-1)。"
    ],
    "suv_mm": {
      "length": 4900,
      "width": 1950,
      "height": 1800,
      "_note": "台灣常見中大型休旅的上緣（Highlander 4966×1930、CR-V 4703×1866），取 4900×1950 為下限基準。"
    },
    "clearance_mm": {
      "driver_side": 700,
      "passenger_side": 350,
      "between_bays": 300,
      "front": 600,
      "rear": 500,
      "_note": "駕駛側 700 是開門下車的最小值；車尾 500 只夠側身通過，不含尾門全開。"
    },
    "ev_charger_mm": {
      "depth": 400,
      "width": 600,
      "clear": 300,
      "mount": "front_wall",
      "_note": "壁掛式充電樁裝在車頭端牆面。車頭服務區取 max(clearance.front, depth + clear)，兩者共用同一段深度而不重複計算。"
    }
  },
  "roof_penthouse": {
    "_note": [
      "屋頂突出物的法規參數，依建築技術規則建築設計施工編第 1 條與第 162 條。",
      "第 1 條：屋頂突出物高度在 6 m 以內（有昇降機通達者 9 m 以內），且『水平投影面積之和』",
      "以不超過建築面積 12.5%（高層建築物 15%）為限，【其未達二十五平方公尺者，得建築二十五平方公尺】。",
      "最後這句但書是關鍵：建築面積小的房子不會因為比例而被壓到極小的屋突，一律至少有 25 m² 可用。",
      "第 162 條：符合第 1 條第 1 目（樓梯間、昇降機間、無線電塔、機械房）之屋頂突出物，得不計入容積總樓地板面積；",
      "機電設備空間另有基地容積 15% 的上限。",
      "本專案建築面積 105.79 m²，12.5% = 13.22 m² < 25 m²，因此適用 25 m² 但書。",
      "這些是條文字面值，不是核准結論。三棟在執照上算一幢還是三幢、地方審查實務如何認定，要建築師書面法規預檢。"
    ],
    "ratio": 0.125,
    "ratio_highrise": 0.15,
    "floor_sqm": 25.0,
    "height_limit_mm": 6000,
    "classes": {
